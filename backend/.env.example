# Application
APP_NAME=亲声伴 QinShengBan
DEBUG=false
SECRET_KEY=your-long-random-secret-key-here
BASE_URL=https://your-domain.com

# Database (PostgreSQL for production)
DATABASE_URL=postgresql://user:password@localhost:5432/qinshengban
# For local dev: sqlite:///./qinshengban.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-xxx

# Twilio (Voice calls + SMS)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+8618xxxxxxxxx

# Storage (S3 for production, local for dev)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./recordings

# AWS S3 (production)
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_S3_BUCKET=qinshengban-recordings
# AWS_REGION=cn-north-1

# Stripe (payments)
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Free trial
FREE_TRIAL_MINUTES=60
