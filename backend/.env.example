# Application
APP_NAME=CompanionCall
DEBUG=false
SECRET_KEY=your-long-random-secret-key-here
BASE_URL=https://your-domain.com

# Database (PostgreSQL for production)
DATABASE_URL=postgresql://user:password@localhost:5432/companioncall
# For local dev: sqlite:///./companioncall.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-xxx

# Twilio (Voice calls + SMS — works globally)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+12125551234   # Your Twilio number in E.164 format

# Storage for call recordings
STORAGE_BACKEND=local              # "local" or "s3"
STORAGE_LOCAL_PATH=./recordings

# AWS S3 (recommended for production)
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_S3_BUCKET=companioncall-recordings
# AWS_REGION=us-east-1             # Change to your preferred region (eu-west-1, ap-southeast-1, etc.)

# Payments — Stripe supports 135+ currencies globally
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Default currency for token packages (ISO 4217: USD, EUR, GBP, JPY, CNY, AUD, CAD, etc.)
DEFAULT_CURRENCY=USD

# Default conversation language for new profiles (BCP-47)
DEFAULT_LANGUAGE=en-US

# Free trial duration for new accounts
FREE_TRIAL_MINUTES=60
